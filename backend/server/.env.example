DATABASE_URL="postgresql://user:password@localhost:5432/weblabs"

# Яндекс Object Storage (совместимо с AWS S3 API)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# Префикс «папки» внутри бакета (файлы: {prefix}/exhibits/:id/…)
S3_UPLOAD_PREFIX=museum-bff
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1

# JWT (обязательно в production; см. ЛР 7)
JWT_SECRET=

# Сиды: администратор после `npx prisma db seed`
SEED_ADMIN_EMAIL=admin@example.local
SEED_ADMIN_PASSWORD=ChangeMe!

# CORS для фронтов (через запятую), credentials включены
CORS_ORIGINS=http://localhost:3000