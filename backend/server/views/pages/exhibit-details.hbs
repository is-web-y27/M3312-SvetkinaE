{{> head}}
<body class="page">
  {{> header}}

  <main class="main">
    <section class="section">
      <h2 class="section__title">{{exhibit.title}}</h2>
      <p>{{exhibit.description}}</p>
      <p>Категория: {{exhibit.category.name}}</p>
      <p>
        <a href="/exhibits/{{exhibit.id}}/edit">Редактировать</a>
      </p>
      <form method="post" action="/exhibits/{{exhibit.id}}/delete">
        <button type="submit">Удалить</button>
      </form>
      <p><a href="/exhibits">Назад к списку</a></p>
    </section>
  </main>

  {{> footer}}
