{{> head}}
<body class="page">
  {{> header}}

  <main class="main">
    <section class="section">
      <h2 class="section__title">{{exhibit.title}}</h2>
      {{#if exhibit.coverImageUrl}}
      <p><img src="{{exhibit.coverImageUrl}}" alt="{{exhibit.title}}" style="max-width: 100%; height: auto;"></p>
      {{/if}}
      <p>{{exhibit.description}}</p>
      <p>Категория: {{exhibit.category.name}}</p>
      <p>
        <a href="/exhibits/{{exhibit.id}}/edit{{authQ isAuth}}">Редактировать</a>
      </p>
      <form method="post" action="/exhibits/{{exhibit.id}}/delete{{authQ isAuth}}">
        <button type="submit">Удалить</button>
      </form>
      <p><a href="/exhibits{{authQ isAuth}}">Назад к списку</a></p>
    </section>
  </main>

  {{> footer}}
