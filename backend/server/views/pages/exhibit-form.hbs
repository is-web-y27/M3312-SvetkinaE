{{> head}}
<body class="page">
  {{> header}}

  <main class="main">
    <section class="section">
      <h2 class="section__title">{{title}}</h2>
      <form method="post" action="{{action}}{{authQ isAuth}}">
        <p>
          <label>Название</label><br>
          <input type="text" name="title" value="{{#if exhibit}}{{exhibit.title}}{{/if}}" required>
        </p>
        <p>
          <label>Описание</label><br>
          <textarea name="description" required>{{#if exhibit}}{{exhibit.description}}{{/if}}</textarea>
        </p>
        <p>
          <label>Категория</label><br>
          <select name="categoryId" required>
            {{#if exhibit}}
              <option value="{{exhibit.categoryId}}" selected>{{exhibit.category.name}}</option>
            {{/if}}
            {{#each categories}}
              <option value="{{id}}">{{name}}</option>
            {{/each}}
          </select>
        </p>
        <button type="submit">Сохранить</button>
      </form>
      <p><a href="/exhibits{{authQ isAuth}}">Назад к списку</a></p>
    </section>
  </main>

  {{> footer}}
