{{> head}}
<body class="page">
  {{> header}}

  <main class="main">
    <section class="section">
      <h2 class="section__title">Экспонаты</h2>
      {{#if isAuth}}
        <p><a href="/exhibits/add">Добавить экспонат</a></p>
      {{/if}}
      <div class="exhibits-list">
        {{#each exhibits}}
          <article class="exhibit">
            <h3 class="exhibit__title">{{title}}</h3>
            <p class="exhibit__text">{{description}}</p>
            <p>Категория: {{category.name}}</p>
            <p>
              <a href="/exhibits/{{id}}">Открыть</a>
              {{#if ../isAuth}}
              |
              <a href="/exhibits/{{id}}/edit">Редактировать</a>
              {{/if}}
            </p>
            {{#if ../isAuth}}
            <form method="post" action="/exhibits/{{id}}/delete">
              <button type="submit">Удалить</button>
            </form>
            {{/if}}
          </article>
        {{/each}}
      </div>
    </section>
  </main>

  {{> footer}}
