{{> head}}
<body class="page">
  {{> header}}

  <main class="main">
    <section class="section">
      <h2 class="section__title">Экспонаты</h2>
      {{#if isAuth}}
        <p><a href="/exhibits/add{{authQ isAuth}}">Добавить экспонат</a></p>
      {{/if}}
      <div class="exhibits-list">
        {{#each exhibits}}
          <article class="exhibit">
            <h3 class="exhibit__title">{{title}}</h3>
            <p class="exhibit__text">{{description}}</p>
            <p>Категория: {{category.name}}</p>
            <p>
              <a href="/exhibits/{{id}}{{authQ isAuth}}">Открыть</a>
              |
              <a href="/exhibits/{{id}}/edit{{authQ isAuth}}">Редактировать</a>
            </p>
            <form method="post" action="/exhibits/{{id}}/delete{{authQ isAuth}}">
              <button type="submit">Удалить</button>
            </form>
          </article>
        {{/each}}
      </div>
    </section>
  </main>

  {{> footer}}
