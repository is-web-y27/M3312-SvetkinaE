{{> head}}
<body class="page">
  {{> header}}

  <main class="main">
    <section class="section">
      <h2 class="section__title">{{item.title}}</h2>
      <p>{{item.text}}</p>
      <p>Дата: {{item.publishedAt}}</p>
      {{#if item.exhibit}}
        <p>Экспонат: {{item.exhibit.title}}</p>
      {{/if}}
      {{#if isAuth}}
      <p>
        <a href="/news/{{item.id}}/edit">Редактировать</a>
      </p>
      <form method="post" action="/news/{{item.id}}/delete">
        <button type="submit">Удалить</button>
      </form>
      {{/if}}
      <p><a href="/news">Назад к списку</a></p>
    </section>
  </main>

  {{> footer}}
