{{> head}}
<body class="page">
  {{> header}}

  <main class="main">
    <section class="section">
      <h2 class="section__title">{{title}}</h2>
      <form method="post" action="{{action}}{{authQ isAuth}}">
        <p>
          <label>Заголовок</label><br>
          <input type="text" name="title" value="{{#if item}}{{item.title}}{{/if}}" required>
        </p>
        <p>
          <label>Текст</label><br>
          <textarea name="text" required>{{#if item}}{{item.text}}{{/if}}</textarea>
        </p>
        <p>
          <label>Экспонат (необязательно)</label><br>
          <select name="exhibitId">
            <option value="">Без привязки</option>
            {{#if item.exhibit}}
              <option value="{{item.exhibit.id}}" selected>{{item.exhibit.title}}</option>
            {{/if}}
            {{#each exhibits}}
              <option value="{{id}}">{{title}}</option>
            {{/each}}
          </select>
        </p>
        <button type="submit">Сохранить</button>
      </form>
      <p><a href="/news{{authQ isAuth}}">Назад к списку</a></p>
    </section>
  </main>

  {{> footer}}
