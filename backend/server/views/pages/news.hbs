{{> head}}
<body class="page">
  {{> header}}

  <main class="main">
    <section class="section">
      <h2 class="section__title">Новости</h2>
      {{#if isAuth}}
        <p><a href="/news/add">Добавить новость</a></p>
      {{/if}}
      <div id="news-events"></div>
      <ul class="news__list">
        {{#each news}}
          <li class="news__item">
            <h4>{{title}}</h4>
            <p>{{text}}</p>
            <p>
              <a href="/news/{{id}}">Открыть</a>
              |
              <a href="/news/{{id}}/edit">Редактировать</a>
            </p>
            <form method="post" action="/news/{{id}}/delete">
              <button type="submit">Удалить</button>
            </form>
          </li>
        {{/each}}
      </ul>
    </section>
  </main>

  <script src="/js/news-sse.js"></script>
  {{> footer}}
