{{> head}}
<body class="page">
  {{> header}}

  <main class="main">
    <section class="section">
      <h2 class="section__title">Отзыв #{{item.id}}</h2>
      <p>Оценка: {{item.rating}}/5</p>
      <p>{{item.text}}</p>
      <p>Посетитель: {{item.visitor.name}}</p>
      <p>Экспонат: {{item.exhibit.title}}</p>
      <p>
        <a href="/reviews/{{item.id}}/edit{{authQ isAuth}}">Редактировать</a>
      </p>
      <form method="post" action="/reviews/{{item.id}}/delete{{authQ isAuth}}">
        <button type="submit">Удалить</button>
      </form>
      <p><a href="/reviews{{authQ isAuth}}">Назад к списку</a></p>
    </section>
  </main>

  {{> footer}}
